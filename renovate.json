{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "constraintsFiltering": "strict",
  "packageRules": [
    {
      "description": "contrib compiles generated code from flamingo.me/graphql and flamingo-commerce, so gqlgen must match their version. Updating those modules raises gqlgen as needed, so skip direct gqlgen updates.",
      "matchPackageNames": [
        "github.com/99designs/gqlgen"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update go run/go install dependencies",
      "managerFilePatterns": [
        "/.*\\.go$/",
        "/Makefile/"
      ],
      "matchStrings": [
        "\\s*go (run|install) (?<depName>([^@]+)?).*@(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "go"
    }
  ]
}
